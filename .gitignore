# ============================================================
# 一、Python 运行时与虚拟环境
# ============================================================
__pycache__/                    # Python 字节码缓存，跨版本不兼容，绝不提交
*.py[cod]                       # .pyc / .pyo / .pyd
*$py.class                      # Jython 编译产物
*.so                            # C 扩展编译产物

.venv/                          # 虚拟环境目录（你项目用的就是 .venv）
venv/
env/
ENV/
env.bak/
venv.bak/

# ============================================================
# 二、依赖与环境变量（生产环境最敏感）
# ============================================================
.env                            # 本地环境变量，含 SECRET_KEY / DATABASE_URL，绝不提交
.env.*                          # .env.local / .env.production 等
!.env.example                   # 例外：示例文件必须提交，供他人参考

# 注意：requirements.txt / requirements.in / pyproject.toml / poetry.lock
# 必须提交，它们是部署可复现的基石，不要加进忽略列表

# ============================================================
# 三、数据库与本地数据
# ============================================================
*.db                            # SQLite 开发库（你的 user_blog.db 在这里被忽略）
*.sqlite
*.sqlite3
*.db-journal                    # SQLite 事务日志
*.db-wal                        # SQLite WAL 模式日志
*.db-shm

# PostgreSQL dump / 备份（迁移前备份文件不应进版本库）
*.dump
*.backup
backup_*.sql
dumps/

# ============================================================
# 四、日志与运行时产物
# ============================================================
logs/                           # 你的 LOG_DIR 默认是 "logs"
*.log
*.log.*                         # RotatingFileHandler 轮转后的 app.log.1 等

# 进程 PID、套接字、临时文件
*.pid
*.sock
*.tmp
*.temp

# ============================================================
# 五、测试与覆盖率
# ============================================================
.pytest_cache/                  # pytest 缓存
.coverage                       # coverage.py 数据文件
.coverage.*
htmlcov/                        # coverage HTML 报告
.tox/                           # tox 环境
.nox/                           # nox 环境
coverage.xml

# ============================================================
# 六、类型检查与代码质量工具缓存
# ============================================================
.mypy_cache/                    # mypy 缓存
.ruff_cache/                    # ruff 缓存
.pyright/                       # pyright 缓存
.pyre/                          # pyre 缓存
.cache/                         # 通用缓存目录

# ============================================================
# 七、IDE 与编辑器
# ============================================================
.vscode/                        # VS Code 配置（若团队统一配置，可提交 .vscode/settings.json，用 ! 例外）
.idea/                          # JetBrains（PyCharm / IntelliJ）
*.iml                           # IntelliJ 模块文件
*.swp                           # Vim 交换文件
*.swo
*~                              # 编辑器备份文件
.history/                       # 某些编辑器的历史目录

# ============================================================
# 八、操作系统
# ============================================================
.DS_Store                       # macOS 目录元数据
.DS_Store?
._*                             # macOS 资源分支
.Spotlight-V100                 # macOS Spotlight 索引
.Trashes                        # macOS 废纸篓
Thumbs.db                       # Windows 缩略图缓存
ehthumbs.db
Desktop.ini                     # Windows 文件夹配置

# ============================================================
# 九、Docker 与容器
# ============================================================
# 如果使用 docker-compose 且包含本地数据卷目录
data/                           # 本地挂载的数据目录（如 PG 数据卷）
docker-compose.override.yml     # 本地覆盖配置（若团队用，可改为提交）

# ============================================================
# 十、Alembic 的临时产物（注意：versions/ 必须提交！）
# ============================================================
# ❌ 不要忽略 alembic/versions/ —— 迁移脚本是数据库演进的唯一来源
# ❌ 不要忽略 alembic.ini —— 迁移环境配置
# 仅忽略可能的临时文件
alembic/versions/__pycache__/

# ============================================================
# 十一、项目特定产物
# ============================================================
# 如果项目有构建产物 / 打包产物
dist/
build/
*.egg-info/
*.egg
.eggs/

# 上传的用户文件（如头像、文章图片），生产环境应存对象存储，本地目录不进 Git
uploads/
media/

# SSL 证书与密钥（绝不提交）
*.pem
*.key
*.crt
*.p12
*.pfx

# SSH 私钥
id_rsa
id_ed25519